        <mxCell id="m8" value="10. PedidoService-&gt;crear():&#10;&#191;caja abierta? &#191;turno activo? &#8594; si no, error CAJA_CERRADA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
