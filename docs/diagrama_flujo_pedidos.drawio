            <mxPoint x="940" y="700" as="targetPoint" />
            <mxPoint x="907" y="688" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m7" value="8. auth:sanctum resuelve el usuario&#10;9. PedidoController@store: $request-&gt;validate(...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="755" y="745" width="470" height="60" as="geometry" />
