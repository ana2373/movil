        <mxCell id="m2" value="2. onClick &#8594; createOrder()" style="edgeStyle=none;html=1;strokeColor=#37474f;strokeWidth=2;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lif1" target="lif2">
