        <mxCell id="m1" value="1. Pulsa &#8220;Cobrar&#8221;" style="edgeStyle=none;html=1;strokeColor=#37474f;strokeWidth=2;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lif0" target="lif1">
