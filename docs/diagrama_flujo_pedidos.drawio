            <Array as="points">
              <mxPoint x="600" y="540" />
              <mxPoint x="715" y="540" />
            </Array>
            <mxPoint x="650" y="540" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m5" value="6. AuthInterceptor: runBlocking { tokenManager.getToken() }&#10;+ header Authorization: Bearer &lt;JWT&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#607d8b;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="755" y="585" width="470" height="60" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="7. HTTP POST /api/v1/pedidos &#10;{cliente_id, total, estado, detalles[], pagos[], factura}" style="edgeStyle=none;html=1;strokeColor=#c62828;strokeWidth=3;endArrow=block;fontSize=12;fontStyle=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lif3" target="lif4">
