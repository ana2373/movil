<mxfile host="app.diagrams.net" agent="opencode" type="device" version="24.7.17">
  <diagram id="pagina-1-capas" name="1. Panorama por capas">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="KAFFA &#8212; Flujo de conexi&#243;n: m&#243;dulo PEDIDOS (POST /pedidos)" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fillColor=none;strokeColor=none;fontColor=#1a237e;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1420" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Android Kotlin + Jetpack Compose  &#8594;  Retrofit / OkHttp  &#8594;  API REST Laravel  &#8594;  MySQL" style="text;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#455a64;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="120" y="58" width="1420" height="25" as="geometry" />
        </mxCell>

        <mxCell id="grpAndroid" value="APP ANDROID (Kotlin)&#10;movil-master" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1976d2;strokeWidth=2;dashed=0;verticalAlign=top;align=center;fontSize=16;fontStyle=1;fontColor=#0d47a1;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="660" height="800" as="geometry" />
        </mxCell>
        <mxCell id="grpServer" value="BACKEND LARAVEL (API REST externa)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;strokeWidth=2;dashed=1;verticalAlign=top;align=center;fontSize=16;fontStyle=1;fontColor=#e65100;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="960" y="100" width="650" height="800" as="geometry" />
        </mxCell>
        <mxCell id="grpNet" value="RED LAN" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;verticalAlign=middle;align=center;fontSize=13;fontColor=#616161;" vertex="1" parent="1">
          <mxGeometry x="730" y="100" width="200" height="800" as="geometry" />
        </mxCell>

        <mxCell id="ui" value="1. UI &#8212; Jetpack Compose&#10;POSScreen.kt / OrderListScreen.kt&#10;&#10;El usuario pulsa &#8220;Cobrar&#8221;.&#10;Aqu&#237; NO hay llamada de red." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="600" height="80" as="geometry" />
        </mxCell>

        <mxCell id="vm" value="2. VIEWMODEL (MVVM)&#10;POSViewModel.createOrder()&#10;ui/pos/POSViewModel.kt:150&#10;&#10;Arma el PedidoRequest desde el CartStore:&#10;estado=&#8220;pendiente&#8221;, caja_id=null, detalles[], pagos[], factura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="250" width="600" height="95" as="geometry" />
        </mxCell>

        <mxCell id="repo" value="3. REPOSITORY&#10;OrderRepositoryImpl.apiCall { ... }&#10;data/repository/OrderRepositoryImpl.kt:12&#10;&#10;Envuelve la llamada y devuelve Resource&lt;T&gt;:&#10;Loading | Success | Error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="375" width="600" height="85" as="geometry" />
        </mxCell>

        <mxCell id="api" value="4. INTERFAZ RETROFIT&#10;OrderApi &#8212; data/remote/api/OrderApi.kt&#10;&#10;@GET(&#8220;pedidos&#8221;)  @GET(&#8220;pedidos/{id}&#8221;)&#10;@POST(&#8220;pedidos&#8221;)  @PUT / @DELETE&#10;&#10;DTOs: OrderDtos.kt + CommonDtos.kt (PaginatedResponse)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="490" width="600" height="100" as="geometry" />
        </mxCell>

        <mxCell id="inter" value="5. INTERCEPTORES OKHTTP&#10;KaffaApp.kt:25&#10;&#10;AuthInterceptor &#8594; Authorization: Bearer &lt;JWT&gt;&#10;DebugInterceptor &#8594; log BODY (solo debug, redacta el token)&#10;Timeouts 30s &#183; GsonConverterFactory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="620" width="600" height="95" as="geometry" />
        </mxCell>

        <mxCell id="url" value="6. BASE URL&#10;util/Constants.kt:14&#10;&#10;Emulador:  http://10.0.2.2:8000/api/v1/&#10;Celular f&#237;sico:  http://192.168.80.15:8000/api/v1/&#10;&#10;AndroidManifest.xml: usesCleartextTraffic=&#8220;true&#8221;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="745" width="600" height="100" as="geometry" />
        </mxCell>

        <mxCell id="routes" value="7. RUTAS + MIDDLEWARE&#10;routes/api.php &#8594; /pedidos&#10;auth:sanctum&#10;&#10;Lee Authorization: Bearer,&#10;resuelve el usuario o 401" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="140" width="590" height="90" as="geometry" />
        </mxCell>

        <mxCell id="ctrl" value="8. CONTROLLER&#10;PedidoController@store&#10;&#10;$request-&gt;validate([...])&#10;&#10;Si falla &#8594; 422 con&#10;{&#8220;message&#8221;,&#8220;errors&#8221;:{...}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="260" width="590" height="90" as="geometry" />
        </mxCell>

        <mxCell id="svc" value="9. SERVICIO / REGLAS DE NEGOCIO&#10;PedidoService-&gt;crear()&#10;&#10;&#8226; &#191;Hay caja ABIERTA?      &#8594; si no: CAJA_CERRADA&#10;&#8226; &#191;Barista con TURNO ACTIVO?&#10;&#8226; Resuelve la caja abierta (el cliente env&#237;a caja_id=null)&#10;&#8226; DB::transaction + lockForUpdate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="380" width="590" height="105" as="geometry" />
        </mxCell>

        <mxCell id="models" value="10. MODELOS ELOQUENT&#10;Pedido &#183; PedidoDetalle &#183; PagoPedido &#183; FacturaVenta&#10;&#10;INSERT pedidos&#10;INSERT pedido_detalles&#10;INSERT pago_pedidos&#10;INSERT factura_ventas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="515" width="590" height="100" as="geometry" />
        </mxCell>

        <mxCell id="db" value="11. BASE DE DATOS&#10;MySQL / MariaDB&#10;&#10;pedidos&#10;pedido_detalles&#10;pago_pedidos &#183; factura_ventas" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#2e7d32;fontSize=12;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1200" y="645" width="180" height="180" as="geometry" />
        </mxCell>

        <mxCell id="resource" value="12. RESOURCE / TRANSFORMER&#10;PedidoResource-&gt;toArray()&#10;&#10;Convierte el modelo a JSON con&#10;las claves que el DTO espera&#10;(&#8220;cliente_id&#8221;,&#8221;medio_pago_id&#8221;,&#8221;created_at&#8221;...)&#10;y los montos como STRING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef6c00;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="990" y="660" width="200" height="150" as="geometry" />
        </mxCell>

