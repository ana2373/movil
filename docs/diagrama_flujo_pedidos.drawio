        <mxCell id="m3" value="3. Valida medio de pago; si es virtual exige comprobanteUrl&#10;4. Convierte CartStore en PedidoRequest (estado=&#8220;pendiente&#8221;, caja_id=null)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1976d2;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="530" y="415" width="480" height="70" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="5. viewModelScope.launch { orderApi.createPedido(request) }&#10;&#8594; corrutina: la UI NO se bloquea" style="edgeStyle=none;html=1;strokeColor=#37474f;strokeWidth=2;endArrow=block;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lif2" target="lif3">
